{
  "name": "cloudrepairs-site",
  "version": "1.0.0",
  "private": true,
  "description": "CloudRepairs — новый сайт: React + TypeScript + Vite, статический пререндер всех страниц",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "import:original": "node scripts/import-original.mjs"
  },
  "dependencies": {
    "@fontsource-variable/onest": "5.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=20"
  }
}
