{
  "name": "vodovoz-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Водовоз — демо-MVP сервиса вызова водовозов (клиент, водитель, администратор)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "build:web": "cross-env NEXT_OUTPUT=export next build",
    "build:android": "cross-env NEXT_OUTPUT=export NEXT_PUBLIC_APP_TARGET=android next build && cap sync android",
    "apk": "npm run build:android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0"
  }
}
